  setPage: (currentPage) =>
    set({ currentPage }),

  openDeletePopup: (id) =>
    set({
      selectedTask: id,
      showPopup: true
    }),

  closeDeletePopup: () =>
    set({
      selectedTask: null,
      showPopup: false
    }),

  currentPage: 1,
  totalPages: 1,

  setCurrentPage: (page) => set({ currentPage: page }),
  setTotalPages: (pages) => set({ totalPages: pages }),
}))
